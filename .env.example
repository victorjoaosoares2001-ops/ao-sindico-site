# Postgres (na Vercel: Storage → Neon cria estas duas automaticamente)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave para assinar a sessão do painel (texto longo e aleatório)
AUTH_SECRET="troque-por-uma-chave-longa-aleatoria"

# Primeiro acesso: por convite de uso único gerado no log do deploy enquanto não houver dona.
# (Opcional) ADMIN_EMAIL/ADMIN_PASSWORD criam um acesso direto no primeiro deploy.
# ADMIN_EMAIL="admin@aosindico.com"
# ADMIN_PASSWORD="defina-uma-senha-forte"

# Imagens do painel: na Vercel, Storage → Blob cria BLOB_READ_WRITE_TOKEN.
# Sem ele, as imagens vão para a pasta abaixo (servidor próprio).
UPLOAD_DIR="./uploads"

# URL pública (SEO, sitemap, canonical, links de convite). Sem ela, usa o domínio de produção da Vercel.
SITE_URL="https://aosindico.com"

# E-mail transacional (opcional) — https://resend.com
# Avisos de novos pedidos à equipe, confirmação ao síndico e ao inscrito, convite e nova senha,
# e o botão "Enviar pelo sistema" para fornecedores. Sem isso, tudo segue por WhatsApp/links.
RESEND_API_KEY=""
EMAIL_FROM="Ao Síndico <contato@aosindico.com>"
