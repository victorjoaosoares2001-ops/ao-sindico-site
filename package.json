{
  "name": "ao-sindico-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma db push --skip-generate && tsx prisma/data-steps.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:steps": "tsx --env-file=.env prisma/data-steps.ts",
    "db:local": "node scripts/postgres-local.mjs",
    "acervo": "node scripts/importar-acervo.mjs",
    "admin:convite": "tsx --env-file=.env scripts/convite.ts",
    "postinstall": "prisma generate",
    "acervo:avaliacoes": "node scripts/importar-avaliacoes.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.2",
    "marked": "^16.0.0",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
